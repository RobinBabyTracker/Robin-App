{
  "expo": {
    "name": "Robin",
    "slug": "robin",
    "scheme": "robin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFD2D9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lilyandserif.robin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lilyandserif.robin",
      "adaptiveIcon": {
        "backgroundColor": "#FFD2D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFD2D9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Robin lets you share photos and videos privately with your family.",
          "cameraPermission": "Robin lets you take photos and videos to share privately with your family.",
          "microphonePermission": "Robin uses the microphone when you record a video to share with your family."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#741D28"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9042bd39-33bc-417c-a94d-14e20f2244b7"
      },
      "router": {}
    },
    "owner": "robinbabytracker"
  }
}
